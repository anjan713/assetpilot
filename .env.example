# AI proxy configuration (api/chat.ts, api/targets.ts).
# Set these in Vercel: Project → Settings → Environment Variables.
# For local testing with `vercel dev`, copy this file to .env.local
# (git-ignored) and fill in the real key. NEVER commit real values.

# Required. Server-side only — never reaches the browser.
AI_API_KEY=

# Optional. Any OpenAI-compatible provider. Default: https://api.openai.com/v1
AI_BASE_URL=

# Optional. Model name at that provider. Default: gpt-4o-mini
AI_MODEL=
